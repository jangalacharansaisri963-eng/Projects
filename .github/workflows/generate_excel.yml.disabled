name: Generate Sales Report Excel

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install pandas openpyxl

    - name: Run Python script
      # We change the working directory to where your script lives
      working-directory: Excels/Pandas/Basics
      run: python sales_report.py

    - name: Upload Excel file as an artifact
      uses: actions/upload-artifact@v4
      with:
        name: sales-report-excel
        # Point the path to the folder where the excel file gets generated
        path: Excels/Pandas/Basics/sales_report.xlsx
        
