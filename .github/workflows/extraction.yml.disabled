name: Extract ScientificCalculator Zip

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  extract-and-clean:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract ScientificCalculator zip and delete archive
        run: |
          # Navigate to the Python folder
          cd Python
          
          # Handle ScientificCalculator
          if [ -f "ScientificCalculator.zip" ]; then
            echo "Extracting ScientificCalculator.zip..."
            mkdir -p temp_sci
            unzip -q ScientificCalculator.zip -d temp_sci
            
            # If the zip contained a single root directory, pull its contents up cleanly
            if [ -d "temp_sci/ScientificCalculator" ]; then
              mkdir -p ScientificCalculator
              cp -r temp_sci/ScientificCalculator/* ScientificCalculator/
            else
              mkdir -p ScientificCalculator
              cp -r temp_sci/* ScientificCalculator/
            fi
            rm -rf temp_sci
            rm ScientificCalculator.zip
          fi

      - name: Commit and push changes
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "Extract ScientificCalculator.zip into single folder and clean up archive"
          branch: main
          
